generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  OPERATOR
}

model Organization {
  id                      String                         @id @default(uuid()) @db.Uuid
  name                    String                         @db.VarChar(160)
  slug                    String                         @unique @db.VarChar(80)
  createdAt               DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @db.Timestamptz(3)
  archivedAt              DateTime?                      @db.Timestamptz(3)
  memberships             Membership[]
  auditEvents             AuditEvent[]
  products                Product[]
  productIdentifiers      ProductIdentifier[]
  suppliers               Supplier[]
  supplierProducts        SupplierProduct[]
  brands                  Brand[]
  categories              Category[]
  customers               Customer[]
  supplierCatalogItems    SupplierCatalogItem[]
  supplierCatalogImports  SupplierCatalogImport[]
  supplierCatalogUploads  SupplierCatalogUpload[]
  supplierCatalogProfiles SupplierCatalogImportProfile[]
  scanIdentifiers         SupplierScanIdentifier[]
  identifications         CatalogIdentification[]
  inventoryLocations      InventoryLocation[]
  inventoryPolicies       ProductInventoryPolicy[]
  inventoryLots           InventoryLot[]
  inventorySerials        InventorySerial[]
  inventoryScopes         InventoryStockScope[]
  inventoryBalances       InventoryBalance[]
  inventoryReceipts       InventoryReceipt[]
  inventoryReceiptLines   InventoryReceiptLine[]
  inventoryCounts         InventoryCountSession[]
  inventoryCountScopes    InventoryCountScope[]
  inventoryCountLines     InventoryCountLine[]
  inventoryMovements      InventoryMovement[]
  inventoryMovementLines  InventoryMovementLine[]
  deliveryNotes DeliveryNote[]
  deliveryNoteLines DeliveryNoteLine[]
  deliveryNoteAllocations DeliveryNoteAllocation[]
}

// Identidad global. El rol y el acceso pertenecen a Membership.
model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(254)
  displayName  String       @db.VarChar(160)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  disabledAt   DateTime?    @db.Timestamptz(3)
  passwordHash String?      @db.VarChar(512)
  memberships  Membership[]
  sessions     Session[]
  auditEvents  AuditEvent[]
}

model Membership {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  userId             String                  @db.Uuid
  role               MembershipRole          @default(OPERATOR)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  revokedAt          DateTime?               @db.Timestamptz(3)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions           Session[]
  catalogImports     SupplierCatalogImport[]
  catalogUploads     SupplierCatalogUpload[]
  identifications    CatalogIdentification[]
  inventoryReceipts  InventoryReceipt[]
  inventoryCounts    InventoryCountSession[]
  inventoryMovements InventoryMovement[]
  confirmedDeliveryNotes DeliveryNote[]

  @@unique([organizationId, userId])
  @@unique([id, userId])
  @@unique([organizationId, id, userId])
  @@index([userId])
}

model Session {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @db.Uuid
  activeMembershipId String?                 @db.Uuid
  tokenHash          String                  @unique @db.Char(64)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  lastUsedAt         DateTime                @default(now()) @db.Timestamptz(3)
  expiresAt          DateTime                @db.Timestamptz(3)
  absoluteExpiresAt  DateTime                @db.Timestamptz(3)
  revokedAt          DateTime?               @db.Timestamptz(3)
  deviceName         String?                 @db.VarChar(80)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeMembership   Membership?             @relation(fields: [activeMembershipId, userId], references: [id, userId], onDelete: Restrict)
  auditEvents        AuditEvent[]
  catalogImports     SupplierCatalogImport[]
  catalogUploads     SupplierCatalogUpload[]
  identifications    CatalogIdentification[]
  inventoryReceipts  InventoryReceipt[]
  inventoryCounts    InventoryCountSession[]
  inventoryMovements InventoryMovement[]

  @@unique([id, userId])
  @@index([userId, revokedAt, expiresAt])
  @@index([activeMembershipId, userId])
  @@index([expiresAt])
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  sessionId      String?       @db.Uuid
  action         String        @db.VarChar(80)
  resourceType   String        @db.VarChar(80)
  resourceId     String?       @db.Uuid
  result         String        @db.VarChar(20)
  requestId      String        @db.Uuid
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  session        Session?      @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt, id])
  @@index([actorUserId, createdAt])
  @@index([sessionId])
  @@index([requestId])
}

enum UnitOfMeasure {
  UNIT
  PAIR
  METER
  CENTIMETER
  LITER
  MILLILITER
  KILOGRAM
  GRAM
}

enum CustomerKind {
  HEALTH_INSURER
  INSTITUTION
  COMPANY
  OTHER
}

model Customer {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  name             String       @db.VarChar(200)
  kind             CustomerKind
  legalName        String?      @db.VarChar(200)
  cuit             String?      @db.VarChar(11)
  taxConditionText String?      @db.VarChar(80)
  addressLine      String?      @db.VarChar(250)
  locality         String?      @db.VarChar(120)
  province         String?      @db.VarChar(100)
  postalCode       String?      @db.VarChar(20)
  contactName      String?      @db.VarChar(160)
  phone            String?      @db.VarChar(50)
  email            String?      @db.VarChar(254)
  notes            String?      @db.VarChar(1000)
  version          Int          @default(1)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt       DateTime?    @db.Timestamptz(3)
  searchText       String       @default("") @db.Text
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  deliveryNotes DeliveryNote[]

  @@unique([organizationId, id])
  @@unique([organizationId, cuit])
  @@index([organizationId, archivedAt, name, id])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum ProductIdentifierKind {
  GTIN
  INTERNAL_CODE
  INTERNAL_BARCODE
}

model Product {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  name                   String                  @db.VarChar(200)
  description            String?                 @db.VarChar(4000)
  presentation           String?                 @db.VarChar(200)
  unitOfMeasure          UnitOfMeasure
  model                  String?                 @db.VarChar(160)
  manufacturerName       String?                 @db.VarChar(160)
  brandId                String?                 @db.Uuid
  categoryId             String?                 @db.Uuid
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  archivedAt             DateTime?               @db.Timestamptz(3)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brand                  Brand?                  @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  category               Category?               @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  identifiers            ProductIdentifier[]
  supplierProducts       SupplierProduct[]
  inventoryPolicy        ProductInventoryPolicy?
  inventoryLots          InventoryLot[]
  inventorySerials       InventorySerial[]
  inventoryScopes        InventoryStockScope[]
  inventoryBalances      InventoryBalance[]
  inventoryReceiptLines  InventoryReceiptLine[]
  inventoryCountScopes   InventoryCountScope[]
  inventoryCountLines    InventoryCountLine[]
  inventoryMovementLines InventoryMovementLine[]

  deliveryNoteLines DeliveryNoteLine[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt, name, id])
  @@index([organizationId, brandId])
  @@index([organizationId, categoryId])
  searchText String @default("") @db.Text
  @@index([searchText(ops: raw("gin_trgm_ops"))],type:Gin)
}

model ProductIdentifier {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  productId       String                @db.Uuid
  kind            ProductIdentifierKind
  value           String                @db.VarChar(128)
  normalizedValue String                @db.VarChar(128)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?             @db.Timestamptz(3)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product         Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  // Incluye archivados: no liberar cÃ³digos histÃ³ricos.
  @@unique([organizationId, kind, normalizedValue])
  @@index([organizationId, productId, archivedAt])
}

model Supplier {
  id                String                         @id @default(uuid()) @db.Uuid
  organizationId    String                         @db.Uuid
  catalogPrefix     String?                        @db.VarChar(32)
  catalogPrefixLength Int?
  catalogNextSequence Int                          @default(1)
  name              String                         @db.VarChar(200)
  legalName         String?                        @db.VarChar(200)
  contactName       String?                        @db.VarChar(160)
  email             String?                        @db.VarChar(254)
  phone             String?                        @db.VarChar(50)
  version           Int                            @default(1)
  createdAt         DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                       @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?                      @db.Timestamptz(3)
  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplierProducts  SupplierProduct[]
  catalogItems      SupplierCatalogItem[]
  catalogImports    SupplierCatalogImport[]
  catalogUploads    SupplierCatalogUpload[]
  catalogProfiles   SupplierCatalogImportProfile[]
  inventoryReceipts InventoryReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, catalogPrefix])
  @@index([organizationId, catalogPrefixLength, catalogPrefix])
  @@index([organizationId, archivedAt, name, id])
  searchText String @default("") @db.Text
  @@index([searchText(ops: raw("gin_trgm_ops"))],type:Gin)
}

model SupplierProduct {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  supplierId          String       @db.Uuid
  productId           String       @db.Uuid
  supplierCode        String?      @db.VarChar(128)
  supplierDescription String?      @db.VarChar(1000)
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt          DateTime?    @db.Timestamptz(3)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier            Supplier     @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  product             Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  catalogItems    SupplierCatalogItem[]
  scanIdentifiers SupplierScanIdentifier[]
  identifications CatalogIdentification[]

  @@unique([organizationId, supplierId, id])
  @@unique([organizationId, supplierId, productId])
  @@unique([organizationId, supplierId, supplierCode])
  @@index([organizationId, productId, archivedAt])
  @@index([organizationId, supplierCode])
}

model Brand {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(160)
  normalizedName String       @db.VarChar(160)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime?    @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, normalizedName])
  @@index([organizationId, archivedAt, name, id])
}

model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(160)
  normalizedName String       @db.VarChar(160)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime?    @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, normalizedName])
  @@index([organizationId, archivedAt, name, id])
}

enum SupplierCatalogImportMode {
  PARTIAL
  COMPLETE
}

enum SupplierCatalogImportStatus {
  PREVIEW
  COMMITTED
}

enum SupplierCatalogRowOutcome {
  CREATED
  UPDATED
  UNCHANGED
  DUPLICATE
  EMPTY
  ERROR
  CONFLICT
}

model SupplierCatalogItem {
  id                              String                     @id @default(uuid()) @db.Uuid
  organizationId                  String                     @db.Uuid
  supplierId                      String                     @db.Uuid
  internalReferenceCode           String                     @db.VarChar(38)
  referenceSequence               Int
  supplierCode                    String?                    @db.VarChar(128)
  description                     String?                    @db.VarChar(1000)
  brandText                       String?                    @db.VarChar(160)
  manufacturerText                String?                    @db.VarChar(200)
  modelText                       String?                    @db.VarChar(160)
  categoryText                    String?                    @db.VarChar(160)
  unitText                        String?                    @db.VarChar(80)
  presentationText                String?                    @db.VarChar(200)
  reportedGtin                    String?                    @db.VarChar(128)
  normalizedReportedGtin          String?                    @db.VarChar(14)
  alternateSupplierCode           String?                    @db.VarChar(128)
  price                           Decimal?                   @db.Decimal(17, 2)
  currency                        String?                    @db.VarChar(3)
  vatRate                         Decimal?                   @db.Decimal(7, 4)
  priceIncludesVat                String                     @default("UNKNOWN") @db.VarChar(7)
  missingFromLatestCompleteListAt DateTime?                  @db.Timestamptz(3)
  version                         Int                        @default(1)
  createdAt                       DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime                   @updatedAt @db.Timestamptz(3)
  archivedAt                      DateTime?                  @db.Timestamptz(3)
  organization                    Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier                        Supplier                   @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  importRows                      SupplierCatalogImportRow[]
  supplierProductId               String?                    @db.Uuid
  supplierProduct                 SupplierProduct?           @relation(fields: [organizationId, supplierId, supplierProductId], references: [organizationId, supplierId, id], onDelete: Restrict, onUpdate: Restrict)
  identifications                 CatalogIdentification[]

  @@unique([organizationId, supplierId, supplierCode])
  @@unique([organizationId, internalReferenceCode])
  // Prisma does not introspect B-tree operator classes; the migration sets varchar_pattern_ops.
  @@index([organizationId, internalReferenceCode], map: "SupplierCatalogItem_reference_prefix_idx")
  @@unique([organizationId, supplierId, referenceSequence],map:"SupplierCatalogItem_organizationId_supplierId_referenceSequence")
  @@index([organizationId, supplierId, archivedAt, referenceSequence, id],map:"SupplierCatalogItem_organizationId_supplierId_archivedAt_refer_")
  @@unique([organizationId, supplierId, id])
  @@index([organizationId, supplierId, archivedAt, supplierCode, id])
  @@index([organizationId, normalizedReportedGtin])
  @@index([organizationId, supplierId, supplierProductId])
  searchText String @default("") @db.Text
  @@index([searchText(ops: raw("gin_trgm_ops"))],type:Gin)
}

// External physical codes have a supplier namespace, never a universal GTIN namespace.
model SupplierScanIdentifier {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  supplierId        String          @db.Uuid
  supplierProductId String          @db.Uuid
  value             String          @db.VarChar(128)
  normalizedValue   String          @db.VarChar(128)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  archivedAt        DateTime?       @db.Timestamptz(3)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplierProduct   SupplierProduct @relation(fields: [organizationId, supplierId, supplierProductId], references: [organizationId, supplierId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, supplierId, normalizedValue])
  @@index([organizationId, supplierId, supplierProductId])
}

// Durable receipt: identical retries have the same effects and never repeat audit events.
model CatalogIdentification {
  id                String              @id @default(uuid()) @db.Uuid
  operationId       String              @db.Uuid
  organizationId    String              @db.Uuid
  actorUserId       String              @db.Uuid
  membershipId      String              @db.Uuid
  sessionId         String              @db.Uuid
  requestHash       String              @db.Char(64)
  supplierId        String              @db.Uuid
  referenceId       String              @db.Uuid
  supplierProductId String              @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership        Membership          @relation(fields: [organizationId, membershipId, actorUserId], references: [organizationId, id, userId], onDelete: Restrict, onUpdate: Restrict)
  session           Session             @relation(fields: [sessionId, actorUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  reference         SupplierCatalogItem @relation(fields: [organizationId, supplierId, referenceId], references: [organizationId, supplierId, id], onDelete: Restrict, onUpdate: Restrict)
  supplierProduct   SupplierProduct     @relation(fields: [organizationId, supplierId, supplierProductId], references: [organizationId, supplierId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, operationId])
  @@index([organizationId, supplierId, referenceId])
}

// InspecciÃ³n temporal: celdas de texto acotadas, nunca el archivo original.
model SupplierCatalogUpload {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  supplierId     String       @db.Uuid
  actorUserId    String       @db.Uuid
  membershipId   String       @db.Uuid
  sessionId      String       @db.Uuid
  fileName       String       @db.VarChar(200)
  contentHash    String       @db.Char(64)
  format         String       @db.VarChar(4)
  sheets         Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime     @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier       Supplier     @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  membership     Membership   @relation(fields: [organizationId, membershipId, actorUserId], references: [organizationId, id, userId], onDelete: Restrict, onUpdate: Restrict)
  session        Session      @relation(fields: [sessionId, actorUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, actorUserId, expiresAt])
  @@index([expiresAt])
}

model SupplierCatalogImport {
  id                  String                      @id @default(uuid()) @db.Uuid
  organizationId      String                      @db.Uuid
  supplierId          String                      @db.Uuid
  actorUserId         String                      @db.Uuid
  membershipId        String                      @db.Uuid
  sessionId           String                      @db.Uuid
  fileName            String                      @db.VarChar(200)
  contentHash         String                      @db.Char(64)
  format              String                      @db.VarChar(4)
  sheetName           String                      @db.VarChar(31)
  headerRow           Int
  mapping             Json
  commercial          Json                        @default("{}")
  saveProfile         Boolean                     @default(false)
  formatFingerprint   String?                     @db.Char(64)
  formatHeaders       Json                        @default("[]")
  mode                SupplierCatalogImportMode
  status              SupplierCatalogImportStatus @default(PREVIEW)
  previewHash         String                      @db.Char(64)
  catalogHash         String                      @db.Char(64)
  summary             Json
  createdAt           DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(3)
  expiresAt           DateTime                    @db.Timestamptz(3)
  committedAt         DateTime?                   @db.Timestamptz(3)
  excludedInvalidRows Boolean                     @default(false)
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier            Supplier                    @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  membership          Membership                  @relation(fields: [organizationId, membershipId, actorUserId], references: [organizationId, id, userId], onDelete: Restrict, onUpdate: Restrict)
  session             Session                     @relation(fields: [sessionId, actorUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  rows                SupplierCatalogImportRow[]

  @@unique([organizationId, supplierId, id])
  @@index([organizationId, supplierId, createdAt, id])
  @@index([organizationId, status, expiresAt])
}

model SupplierCatalogImportRow {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  supplierId     String                    @db.Uuid
  importId       String                    @db.Uuid
  rowNumber      Int
  outcome        SupplierCatalogRowOutcome
  itemId         String?                   @db.Uuid
  supplierCode   String?                   @db.VarChar(128)
  // Snapshot canónico de datos comerciales válidos, o null para errores/vacías.
  data           Json?
  messages       Json
  import         SupplierCatalogImport     @relation(fields: [organizationId, supplierId, importId], references: [organizationId, supplierId, id], onDelete: Restrict, onUpdate: Restrict)
  item           SupplierCatalogItem?      @relation(fields: [organizationId, supplierId, itemId], references: [organizationId, supplierId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, importId, rowNumber])
  @@index([organizationId, importId, outcome, rowNumber])
  @@index([organizationId, supplierId, itemId])
}

enum InventoryCondition {
  USABLE
  DAMAGED
  QUARANTINE
}

enum InventoryDocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum InventoryMovementType {
  OUTBOUND
  RECEIPT
  INITIAL_COUNT
  ADJUSTMENT
}

model InventoryLocation {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  code           String                  @db.VarChar(40)
  name           String                  @db.VarChar(160)
  archivedAt     DateTime?               @db.Timestamptz(3)
  scopes         InventoryStockScope[]
  balances       InventoryBalance[]
  receipts       InventoryReceipt[]
  receiptLines   InventoryReceiptLine[]
  counts         InventoryCountSession[]
  countScopes    InventoryCountScope[]
  countLines     InventoryCountLine[]
  movementLines  InventoryMovementLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

model ProductInventoryPolicy {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId          String       @db.Uuid
  product            Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
