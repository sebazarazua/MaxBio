# Solo desarrollo local. No usar estas credenciales fuera del equipo local.
POSTGRES_USER=maxbio
POSTGRES_PASSWORD=maxbio_local
POSTGRES_DB=maxbio
POSTGRES_PORT=15432
DATABASE_URL=postgresql://maxbio:maxbio_local@localhost:15432/maxbio?schema=public
API_HOST=127.0.0.1
API_PORT=3001
NODE_ENV=development
# Origen público exacto (sin slash final); HTTPS obligatorio en producción.
WEB_ORIGIN=http://localhost:3000
SESSION_ABSOLUTE_DAYS=180
SESSION_IDLE_DAYS=30
SESSION_ACTIVITY_MINUTES=15
# ARCA V2: solo WSAA de homologación. No admite otro endpoint.
ARCA_WSAA_ENDPOINT=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
# OpenSSL 3.x o superior (req, x509, cms). Sin configurar se usa `openssl` del PATH.
# En Windows usar `/` en la ruta absoluta. Reiniciar la API (o guardar .env con pnpm dev) al cambiarla.
# ARCA_OPENSSL_PATH=C:/Program Files/OpenSSL-Win64/bin/openssl.exe
# Directorio privado persistente; nunca ubicarlo en public/ ni servirlo por HTTP.
# ARCA_CREDENTIAL_STORAGE_DIR=.maxbio-private-credentials
